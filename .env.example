# Copy this file to .env and fill in your own values. Never commit .env.
# All values below are placeholders.

# API key of your Azure OpenAI resource.
AZURE_API_KEY=your-azure-openai-api-key

# Base URL of your Azure OpenAI resource (replace YOUR-RESOURCE with its name).
AZURE_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/

# ngrok auth token, needed only to expose an agent to the live arena.
NGROK_TOKEN=your-ngrok-auth-token
